---
interface Props {
  src?: string;
  alt?: string;
  ratio?: string;
  label?: string;
}

const { src, alt = '', ratio = '16 / 10', label = 'GIF slot' } = Astro.props;
---

{
  src ? (
    <img class="ph-img" src={src} alt={alt} loading="lazy" decoding="async" />
  ) : (
    <div class="ph-empty" style={`--ratio: ${ratio}`}>
      <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
        <rect x="2.5" y="4.5" width="19" height="15" rx="2.5" />
        <path d="M10 9.5l5 2.5-5 2.5z" stroke-linejoin="round" />
      </svg>
      <span>{label}</span>
    </div>
  )
}

<style>
  .ph-img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 10px;
    border: 1px solid var(--border);
  }
  .ph-empty {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.35rem;
    aspect-ratio: var(--ratio);
    border: 1px dashed var(--border);
    border-radius: 10px;
    background:
      repeating-linear-gradient(
        45deg,
        transparent,
        transparent 9px,
        color-mix(in srgb, var(--border) 45%, transparent) 9px,
        color-mix(in srgb, var(--border) 45%, transparent) 10px
      );
    color: var(--muted);
    font-size: 0.75rem;
    font-family: var(--font-mono);
    letter-spacing: 0.02em;
  }
</style>